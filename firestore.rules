rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGroupMember(groupId) {
      return request.auth != null
          && exists(
            /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
          );
    }

    // Profile document at /users/{uid}.
    match /users/{uid} {
      allow create, read, update: if request.auth != null
          && request.auth.uid == uid;
      allow delete: if false;
    }

    // Existing access to user-owned subcollections.
    match /users/{uid}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null
          && request.auth.uid == uid;
    }

    // Only authoritative group members can read a group.
    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow write: if false;

      // Users can read their own membership, not a member roster.
      match /members/{memberUid} {
        allow read: if request.auth != null
            && request.auth.uid == memberUid;
        allow write: if false;
      }
    }

    // Invite validation and management belong to the backend.
    match /groupInvites/{inviteCode} {
      allow read, write: if false;
    }
  }
}